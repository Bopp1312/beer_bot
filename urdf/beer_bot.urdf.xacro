<?xml version="1.0"?>
<robot name="diff_drive_robot" xmlns:xacro="http://ros.org/wiki/xacro">

  <!-- === Robot Dimensions === -->
  <xacro:property name="wheel_base" value="0.150"/>     <!-- Left to right distance -->
  <xacro:property name="wheel_throw" value="0.1"/>    <!-- Front to back distance -->
  <xacro:property name="wheel_radius" value="0.032"/> <!-- 64mm diameter wheels -->
  <xacro:property name="wheel_width" value="0.025"/>   <!-- Estimated wheel thickness -->
  <xacro:property name="lidar_height" value="0.175"/>   <!-- 200mm above axle -->

<!-- === Base Footprint === -->
  <link name="base_footprint">
    <visual>
      <geometry>
        <cylinder radius="0.05" length="0.05"/>
      </geometry>
      <material name="blue"><color rgba="0 0 1 1"/></material>
    </visual>
  </link>

  <!-- === Base Link === -->
  <link name="base_link">
    <visual>
      <geometry>
        <box size="0.5 0.4 0.1"/>
      </geometry>
      <material name="gray">
        <color rgba="0.6 0.6 0.6 1"/>
      </material>
    </visual>
    <collision>
      <geometry>
        <box size="0.5 0.4 0.1"/>
      </geometry>
    </collision>
    <!-- <inertial>
      <mass value="5.0"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <inertia ixx="0.1" iyy="0.1" izz="0.1"
               ixy="0.0" ixz="0.0" iyz="0.0"/>
    </inertial> -->
  </link>

  <!-- === Wheel Macro === -->
  <xacro:macro name="wheel" params="prefix x y">
    <link name="${prefix}">
      <visual>
        <geometry>
          <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
        </geometry>
        <material name="black"><color rgba="0.1 0.1 0.1 1"/></material>
      </visual>
      <collision>
        <geometry>
          <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
        </geometry>
      </collision>
      <inertial>
        <mass value="0.5"/>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <inertia ixx="0.01" iyy="0.01" izz="0.01"
                 ixy="0.0" ixz="0.0" iyz="0.0"/>
      </inertial>
    </link>

    <joint name="${prefix}_joint" type="continuous">
      <parent link="base_link"/>
      <child link="${prefix}"/>
      <origin xyz="${x} ${y} 0" rpy="0 1.5708 0"/>
      <axis xyz="0 1 0"/>
    </joint>
  </xacro:macro>

  <!-- === Wheels === -->
  <xacro:wheel prefix="wheel_fl" x="${wheel_throw / 2}" y="${wheel_base / 2}"/>
  <xacro:wheel prefix="wheel_fr" x="${wheel_throw / 2}" y="${-wheel_base / 2}"/>
  <xacro:wheel prefix="wheel_rl" x="${-wheel_throw / 2}" y="${wheel_base / 2}"/>
  <xacro:wheel prefix="wheel_rr" x="${-wheel_throw / 2}" y="${-wheel_base / 2}"/>

  <!-- === LIDAR === -->
  <link name="lidar_link">
    <visual>
      <geometry>
        <cylinder radius="0.05" length="0.05"/>
      </geometry>
      <material name="blue"><color rgba="0 0 1 1"/></material>
    </visual>
  </link>

  <joint name="lidar_joint" type="fixed">
    <parent link="base_link"/>
    <child link="lidar_link"/>
    <origin xyz="0.007 0 ${lidar_height}" rpy="0 0 0"/>
  </joint>

    <joint name="base_joint" type="fixed">
    <parent link="base_link"/>
    <child link="base_footprint"/>
    <origin xyz="0.0 0 -${wheel_radius}" rpy="0 0 0"/>
  </joint>

</robot>
